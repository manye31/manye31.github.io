---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image_folder %}
          {% comment %}
            Rotating profile photo: every image in assets/img/<image_folder>/ is a candidate. Each visitor sees them in a
            random order with no repeats until all have been shown. The page always opens on the first photo (alphabetically),
            then cross-fades to the next one every 5 seconds and on click.
          {% endcomment %}
          {% include folder_images.liquid folder=page.profile.image_folder %}
          {% assign rotation_display = folder_images %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          <figure class="profile-rotation">
            <img
              class="{{ profile_image_class }}"
              src="{{ rotation_display.first | relative_url }}"
              alt="Photo of {{ site.first_name }} {{ site.last_name }}"
              width="480"
              height="480"
            >
          </figure>
          <div class="secret-popup" role="status" hidden>
            <span class="secret-popup-text">You found a secret!</span>
            <a href="{{ '/hobbies/' | relative_url }}">Learn more about me →</a>
            <button type="button" class="secret-popup-close" aria-label="Close">×</button>
          </div>
          <script>
            (function () {
              var images = {{ rotation_display | jsonify }}.map(function (path) {
                return '{{ site.baseurl }}' + encodeURI(path);
              });
              var figure = document.currentScript.parentElement.querySelector('.profile-rotation');
              var INTERVAL = 5000; // ms between automatic switches
              var FADE = 900; // ms, keep in sync with the CSS transition
              if (images.length < 2) return;

              // Always start on the first photo (alphabetically). After that, a shuffle bag:
              // random order, no repeats until every photo has been shown, never the same photo twice in a row.
              var current = images[0];
              var bag = [];
              function shuffle(list) {
                for (var i = list.length - 1; i > 0; i--) {
                  var j = Math.floor(Math.random() * (i + 1));
                  var t = list[i];
                  list[i] = list[j];
                  list[j] = t;
                }
                return list;
              }
              function refill() {
                if (bag.length === 0) {
                  bag = shuffle(
                    images.filter(function (p) {
                      return p !== current;
                    })
                  );
                  // Each round covers every photo; the one on screen goes last so it isn't repeated right away
                  bag.push(current);
                }
              }
              function next() {
                refill();
                current = bag.shift();
                return current;
              }

              // Decode the upcoming photo ahead of time so a switch (especially a click) starts instantly
              var decoded = {};
              function preloadUpcoming() {
                refill();
                var src = bag[0];
                if (decoded[src]) return;
                var img = new Image();
                img.src = src;
                decoded[src] = img.decode ? img.decode().catch(function () {}) : Promise.resolve();
              }

              // Cross-fade: a fresh image is decoded first, then fades in over the current one, which is removed afterwards.
              // A click during a fade snaps that fade to its end and starts the next one right away.
              var request = 0;
              var fading = null;
              var fadeTimer = null;
              var timer = null;
              function finishFade() {
                if (!fading) return;
                clearTimeout(fadeTimer);
                fading.classList.add('no-transition');
                fading.classList.remove('profile-rotation-incoming', 'is-visible');
                figure.querySelectorAll('img').forEach(function (img) {
                  if (img !== fading) img.remove();
                });
                void fading.offsetWidth;
                fading.classList.remove('no-transition');
                fading = null;
              }
              function crossfade() {
                finishFade();
                var mine = ++request;
                var src = next();
                var incoming = figure.querySelector('img').cloneNode(false);
                incoming.className = incoming.className.replace(/\s*(profile-rotation-incoming|is-visible|no-transition)/g, '');
                incoming.classList.add('profile-rotation-incoming');
                incoming.src = src;
                var ready = decoded[src] || (incoming.decode ? incoming.decode() : Promise.resolve());
                delete decoded[src];
                ready
                  .catch(function () {})
                  .then(function () {
                    if (mine !== request) return; // a newer click took over while this photo was loading
                    finishFade();
                    figure.appendChild(incoming);
                    void incoming.offsetWidth;
                    incoming.classList.add('is-visible');
                    fading = incoming;
                    fadeTimer = setTimeout(finishFade, FADE + 50);
                    preloadUpcoming();
                  });
              }
              function restartTimer() {
                clearInterval(timer);
                timer = setInterval(function () {
                  if (!document.hidden) crossfade();
                }, INTERVAL);
              }

              // Secret: the 3rd click on the photo reveals a link to the hidden hobbies page
              var clicks = 0;
              var popup = figure.parentElement.querySelector('.secret-popup');
              popup.querySelector('.secret-popup-close').addEventListener('click', function () {
                popup.classList.remove('is-open');
                setTimeout(function () {
                  popup.hidden = true;
                }, 250);
              });

              figure.addEventListener('click', function () {
                crossfade();
                restartTimer();
                clicks++;
                if (clicks === 3) {
                  popup.hidden = false;
                  void popup.offsetWidth;
                  popup.classList.add('is-open');
                }
              });
              preloadUpcoming();
              restartTimer();
            })();
          </script>
        {% elsif page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="about-section">
      <h2 class="section-heading">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="about-section">
      <h2 class="section-heading">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="about-section">
      <h2 class="section-heading">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Selected community service -->
    {% if page.selected_community_service %}
      <section class="about-section">
      <h2 class="section-heading">
        <a href="{{ '/community/' | relative_url }}" style="color: inherit">Selected Community Engagement</a>
      </h2>
      {% include selected_community_service.liquid %}
      </section>
    {% endif %}

    <!-- Professional service -->
    {% if page.professional_service and page.professional_service.enabled %}
      <section class="about-section">
      <h2 class="section-heading">
        <a href="{{ '/professional_service/' | relative_url }}" style="color: inherit">Professional Service</a>
      </h2>
      {% include professional_service.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    <!-- Secret: appears once a visitor scrolls all the way to the bottom -->
    <p class="secret-bottom" aria-hidden="true">
      👀 You made it all the way down. <a href="{{ '/hobbies/' | relative_url }}" tabindex="-1">Here's a little more about me →</a>
    </p>
    <script>
      (function () {
        var note = document.currentScript.previousElementSibling;
        function check() {
          var atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8;
          if (!atBottom) return;
          note.classList.add('is-revealed');
          note.removeAttribute('aria-hidden');
          note.querySelector('a').removeAttribute('tabindex');
          window.removeEventListener('scroll', check);
        }
        window.addEventListener('scroll', check, { passive: true });
      })();
    </script>

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
