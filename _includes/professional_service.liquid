<div class="news">
  {% if site.professional_service != blank %}
    {% assign professional_service_size = site.professional_service | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.professional_service.scrollable and professional_service_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign professional_service = site.professional_service | reverse %}
        {% if include.limit and page.professional_service.limit %}
          {% assign professional_service_limit = page.professional_service.limit %}
        {% else %}
          {% assign professional_service_limit = professional_service_size %}
        {% endif %}
        {% for item in professional_service limit: professional_service_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No professional service so far...</p>
  {% endif %}
</div>