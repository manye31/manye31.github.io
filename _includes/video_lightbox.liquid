<!-- In-page player for publication Video buttons (YouTube / Google Drive links); see common.js -->
<div id="video-lightbox" class="video-lightbox" hidden>
  <div class="video-lightbox-frame">
    <button type="button" class="video-lightbox-close" aria-label="Close video">&times;</button>
    <iframe title="Video" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
  </div>
</div>
